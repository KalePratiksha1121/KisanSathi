<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kisan_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->

        <TextView
            android:id="@+id/profileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/create_profile"
            android:textColor="@color/dark_green"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/profileSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_subtitle"
            android:textColor="@color/secondary_text"
            android:textSize="15sp" />

        <!-- User Type -->

        <TextView
            android:id="@+id/userTypeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/i_am_a"
            android:textColor="@color/dark_green"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/userTypeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/farmerOption"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/language_card"
                android:gravity="center"
                android:text="@string/farmer"
                android:textColor="@color/dark_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expertOption"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/language_card"
                android:gravity="center"
                android:text="@string/expert"
                android:textColor="@color/dark_green"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Full Name -->

        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/language_card"
            android:hint="@string/full_name"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/dark_green"
            android:textColorHint="@color/secondary_text"
            android:textSize="16sp" />

        <!-- Verified Mobile -->

        <EditText
            android:id="@+id/mobileInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/language_card"
            android:hint="@string/mobile_number"
            android:inputType="phone"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/dark_green"
            android:textColorHint="@color/secondary_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/mobileVerifiedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="✓ Mobile number verified"
            android:textColor="@color/dark_green"
            android:textSize="13sp" />

        <!-- Village -->

        <EditText
            android:id="@+id/villageInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/language_card"
            android:hint="@string/village"
            android:inputType="text|textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/dark_green"
            android:textColorHint="@color/secondary_text"
            android:textSize="16sp" />

        <!-- District -->

        <EditText
            android:id="@+id/districtInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/language_card"
            android:hint="@string/district"
            android:inputType="text|textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/dark_green"
            android:textColorHint="@color/secondary_text"
            android:textSize="16sp" />

        <!-- Continue -->

        <TextView
            android:id="@+id/profileContinueButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/continue_button"
            android:gravity="center"
            android:text="@string/continue_text"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>