<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kisan_background">

    <ScrollView
        android:id="@+id/diseaseScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="30dp">

        <LinearLayout
            android:id="@+id/diseaseRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <!-- HEADER -->

            <LinearLayout
                android:id="@+id/diseaseHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/diseaseBackButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_white"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="@color/dark_green"
                    android:textSize="32sp"
                    android:fontFamily="sans"
                    android:contentDescription="Back"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disease Detection"
                        android:textColor="@color/dark_green"
                        android:textSize="23sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="AI-powered crop health analysis"
                        android:textColor="@color/secondary_text"
                        android:textSize="13sp"/>

                </LinearLayout>

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/circle_soft_green"
                    android:gravity="center"
                    android:text="🌿"
                    android:textSize="20sp"/>

            </LinearLayout>


            <!-- CAPTURED IMAGE -->

            <FrameLayout
                android:id="@+id/diseaseImageCard"
                android:layout_width="match_parent"
                android:layout_height="265dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/language_card"
                android:clipToOutline="true"
                android:elevation="4dp">

                <ImageView
                    android:id="@+id/diseaseCropImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Captured crop leaf"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#16000000"/>

                <!-- PROCESSING OVERLAY -->

                <LinearLayout
                    android:id="@+id/diseaseOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="#85000000">

                    <ProgressBar
                        android:id="@+id/diseaseProgress"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminate="true"/>

                    <TextView
                        android:id="@+id/diseaseProcessingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Analyzing crop leaf..."
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Running AI model on your device"
                        android:textColor="#DDFFFFFF"
                        android:textSize="12sp"/>

                </LinearLayout>

                <!-- AI BADGE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    android:background="@drawable/ai_badge_background"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="ON-DEVICE AI"
                    android:textColor="@color/dark_green"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

            </FrameLayout>


            <!-- RESULT CARD -->

            <LinearLayout
                android:id="@+id/diseaseResultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/disease_result_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI ANALYSIS"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/diseaseIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/result_icon_background"
                        android:gravity="center"
                        android:text="🧪"
                        android:textSize="24sp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Preliminary detection"
                            android:textColor="@color/secondary_text"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/diseaseTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Analyzing..."
                            android:textColor="@color/dark_green"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- CONFIDENCE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="MODEL CONFIDENCE"
                    android:textColor="@color/secondary_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/diseaseConfidenceBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="@color/dark_green"
                        android:backgroundTint="@color/soft_green"/>

                    <TextView
                        android:id="@+id/diseaseConfidence"
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="right"
                        android:text="--"
                        android:textColor="@color/dark_green"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/diseaseDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:lineSpacingExtra="3dp"
                    android:text="The AI model is analyzing your crop leaf."
                    android:textColor="@color/secondary_text"
                    android:textSize="14sp"/>

            </LinearLayout>


            <!-- JOURNEY TITLE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Analysis Journey"
                android:textColor="@color/dark_green"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <!-- JOURNEY CARD -->

            <LinearLayout
                android:id="@+id/diseaseJourneyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/language_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- STEP 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/step_done_background"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/dark_green"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/diseaseStatusStep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Crop leaf validated"
                        android:textColor="@color/dark_green"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <View
                    android:layout_width="2dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="14dp"
                    android:background="@color/soft_green"/>


                <!-- STEP 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/step_active_background"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/diseaseResultStep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Disease detection"
                        android:textColor="@color/dark_green"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <View
                    android:layout_width="2dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="14dp"
                    android:background="@color/soft_green"/>


                <!-- STEP 3 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/step_pending_background"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/secondary_text"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/expertValidationStep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Expert validation required"
                        android:textColor="@color/secondary_text"
                        android:textSize="14sp"/>

                </LinearLayout>

            </LinearLayout>


            <!-- EXPERT NOTE -->

            <LinearLayout
                android:id="@+id/expertNoteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/expert_note_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/expert_icon_background"
                    android:gravity="center"
                    android:text="👨‍🌾"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="AI gives a preliminary result. Expert validation is required before confirmation."
                    android:textColor="@color/dark_green"
                    android:textSize="12sp"/>

            </LinearLayout>


            <!-- CONTINUE BUTTON -->

            <TextView
                android:id="@+id/continueToExpertButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/expert_button_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Continue to Expert Validation   →"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </ScrollView>

</FrameLayout>