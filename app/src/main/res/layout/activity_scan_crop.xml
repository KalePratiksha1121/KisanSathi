<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scanRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Real CameraX preview will appear here -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/scanBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_white"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/dark_green"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crop Scanner"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scanStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Camera ready"
                android:textColor="#E8F5E9"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/flashButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_white"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⚡"
            android:textSize="21sp" />

    </LinearLayout>

    <!-- Scanner area -->
    <FrameLayout
        android:layout_width="290dp"
        android:layout_height="350dp"
        android:layout_gravity="center"
        android:clipChildren="false">

        <!-- Scanner border -->
        <View
            android:id="@+id/scannerFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scanner_frame" />

        <!-- Animated scanning line -->
        <View
            android:id="@+id/scanningLine"
            android:layout_width="240dp"
            android:layout_height="3dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="35dp"
            android:background="#8BC34A" />

    </FrameLayout>

    <!-- Center instruction -->
    <TextView
        android:id="@+id/scanInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="145dp"
        android:gravity="center"
        android:text="Place a clear crop leaf inside the frame"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="125dp"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/cameraHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keep the leaf steady and well lit"
            android:textColor="#E8F5E9"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/captureButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/capture_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="●"
            android:textColor="@android:color/white"
            android:textSize="30sp" />

    </LinearLayout>

</FrameLayout>